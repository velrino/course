    {
      "parameters": {
        "jsCode": "const envelope = $input.first().json;\nconst order = envelope.body && typeof envelope.body === 'object' ? envelope.body : envelope;\nconst validationErrors = [];\nconst totalCents = Number(order.totalCents);\nconst riskScore = order.riskScore === undefined ? 0 : Number(order.riskScore);\nif (typeof order.orderId !== 'string' || order.orderId.trim() === '') validationErrors.push('orderId must be a non-empty string');\nif (typeof order.customerId !== 'string' || order.customerId.trim() === '') validationErrors.push('customerId must be a non-empty string');\nif (typeof order.currency !== 'string' || !/^[A-Z]{3}$/.test(order.currency)) validationErrors.push('currency must be a three-letter uppercase code');\nif (!Number.isSafeInteger(totalCents) || totalCents < 0) validationErrors.push('totalCents must be a non-negative safe integer');\nif (!Number.isInteger(riskScore) || riskScore < 0 || riskScore > 100) validationErrors.push('riskScore must be an integer from 0 through 100');\nlet route = 'automatic';\nif (validationErrors.length > 0) route = 'invalid';\nelse if (totalCents >= 100000 || riskScore >= 70) route = 'manual_review';\nreturn [{ json: { ...order, totalCents, riskScore, route, validationErrors } }];"
      },
      "type": "n8n-nodes-base.code",
